# Closed-source providers
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
GEMINI_VERTEX_PROJECT_ID=project-1edeecda-ad08-47a7-867
GEMINI_VERTEX_LOCATION=us-central1
ANTHROPIC_API_KEY=your_sonnet_api_key_here

# Local Ollama providers — llama, llava, minicpm, gemma all share these vars.
# LLAMA_API_KEY is not needed for local Ollama; leave blank or omit.
# LLAMA_API_KEY=your_llama_api_key_here
LLAMA_BASE_URL=http://localhost:11434/v1
# Model is configured via llm_model in gifdroid_llm/input/config.yml
# Supported llm values: "llama", "llava", "minicpm", "gemma"
# Default models:
#   llama   -> llama3.2-vision:latest  (3B, 7.8 GB)
#   llama   -> llama3.2-vision:11b     (11B, 7.9 GB) — stronger reasoning
#   llava   -> llava:7b                (7B, 4.7 GB)  — fast, good instruction following
#   minicpm -> minicpm-v:latest        (8B, 5.5 GB)  — excellent for dense UI screenshots
#   gemma   -> gemma3:4b               (4B, 3.3 GB)  — Google's latest, small footprint
# Optional: timeout for the prerequisite check (seconds). Omit for no limit.
# LLAMA_PREREQ_TIMEOUT_SEC=90
# Optional: per-inference timeout (seconds). Omit for no limit.
# LLAMA_TIMEOUT_SEC=180

# Qwen via local Ollama (recommended for Apple Silicon — set llm: "qwen" in config.yml)
QWEN_BASE_URL=http://localhost:11434/v1
# QWEN_API_KEY is not needed for local Ollama; leave blank or omit.
# QWEN_API_KEY=your_qwen_api_key_here
# Optional: timeout for the prerequisite check (seconds). Omit for no limit.
# QWEN_PREREQ_TIMEOUT_SEC=90
# Optional: per-inference timeout (seconds). Omit for no limit.
# QWEN_TIMEOUT_SEC=300
