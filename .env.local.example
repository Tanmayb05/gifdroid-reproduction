# Closed-source providers
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
GEMINI_VERTEX_PROJECT_ID=project-1edeecda-ad08-47a7-867
GEMINI_VERTEX_LOCATION=us-central1
ANTHROPIC_API_KEY=your_sonnet_api_key_here

# Open-source/self-hosted providers (OpenAI-compatible style)
LLAMA_API_KEY=your_llama_api_key_here
LLAMA_BASE_URL=http://localhost:11434/v1
# Model is configured via llm_model in gifdroid_llm/input/config.yml
# Optional: timeout for the prerequisite check (seconds). Omit for no limit.
# LLAMA_PREREQ_TIMEOUT_SEC=90
# Optional: per-inference timeout (seconds). Omit for no limit.
# LLAMA_TIMEOUT_SEC=180

QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://your-qwen-endpoint.example/v1
QWEN_MODEL=qwen2.5-vl-72b-instruct
